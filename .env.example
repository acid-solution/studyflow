PORT=8081
MYSQL_DSN=studyflow:REDACTED@tcp(127.0.0.1:3307)/studyflow?charset=utf8mb4&parseTime=True&loc=UTC
MIGRATIONS_DIR=migrations
AUTH_JWKS_URL=http://127.0.0.1:18082/.well-known/jwks.json
AUTH_ISSUER=shared-auth
AUTH_AUDIENCE=studyflow
FRONTEND_URL=http://127.0.0.1:5174
JWKS_CACHE_TTL=10m

# 读缓存。关闭时服务直接读 MySQL。
CACHE_ENABLED=true
REDIS_ADDR=127.0.0.1:6379
# 只给需要密码的外部 Redis 用。compose 里自带的那个没有密码，填了反而会让
# 客户端发一个服务端不认的 AUTH，缓存会静默失效。
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=30s

# 监听地址。默认只监听回环：本机可访问，局域网访问不到，Windows 也不会为它弹
# 入站防火墙授权。容器里必须用 0.0.0.0，compose 已经显式设了。
APP_HOST=127.0.0.1
